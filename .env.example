# Copy to backend/.env for local runs. Never commit real values.
# Only variables read by the current code are listed; new ones are added with their feature.

DOCUMIND_ENVIRONMENT=local          # local | test | staging | production
DOCUMIND_LOG_LEVEL=INFO
DOCUMIND_LOG_JSON=false             # human-readable logs locally; JSON in deployed envs
DOCUMIND_CORS_ORIGINS=["http://localhost:3000"]

# --- Added in later milestones (not read yet) ---
# DOCUMIND_DATABASE_URL=            # 2.2
# DOCUMIND_REDIS_URL=               # 2.2
# DOCUMIND_JWT_SECRET=              # 2.5
# GEMINI_API_KEY=                   # 3.5 (charts/images), 5 (agents)
# LANGFUSE_PUBLIC_KEY= / LANGFUSE_SECRET_KEY=   # optional tracing
